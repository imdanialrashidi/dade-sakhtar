---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';

const entries = await getEntriesByKind('concept');
---

<ListingLayout
  title="مفاهیم"
  description="مفاهیم پایهٔ ساختمان داده‌ها و الگوریتم‌ها — الگوریتم، مرتبه و نمادهای مجانبی — هرکدام دقیق و با مثال. برای شروع از صفر یا مرور سریع بخوانید."
  entries={entries}
/>
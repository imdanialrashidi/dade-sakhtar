---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getEntriesByKind } from '../../lib/content';

const entries = await getEntriesByKind('lesson');
---

<ListingLayout
  title="درس‌ها"
  description="درس‌های ساختمان داده‌ها و الگوریتم‌ها به‌ترتیب وابستگی: از تعریف الگوریتم تا نمادهای مجانبی. هر درس را بخوانید، مثالش را حل کنید و با تمرین بسنجید."
  entries={entries}
/>